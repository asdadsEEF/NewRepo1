          rel="stylesheet"
          type="text/css" />

    <link href="../Contents/css/style.css"
          rel="stylesheet"
          type="text/css" />

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>

</head>

<body>


    <header>

        <div class="container">

            <div class="pull-left logo-onpe">

                <div class="pull-left">

                    <a href="index.aspx">

                        <img src="../Contents/images/onpe-trans.png" />

                    </a>

                </div>

                <div class="pull-left">

                    <h1>PRESENTACIÓN DE RESULTADOS</h1>

                </div>

            </div>

            <div class="pull-right logo">

                <img src="../Contents/images/eegg2016-trans.png"
                     width="218"
                     height="35" />

            </div>

        </div>

    </header>



    <form id="form1" runat="server">

        <asp:ContentPlaceHolder
